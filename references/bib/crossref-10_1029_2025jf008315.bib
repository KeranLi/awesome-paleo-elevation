  author  = { Kong, Kai and Guo, Yangrui and Tang, He and Tang, Fei and Chen, Yiwei and Wei, Gangjian and Deng, Wenfeng },
  title   = {{Quantifying Elevation Effects on δ
                    <sup>13</sup>
                    C, δ
                    <sup>18</sup>
                    O, and Clumped Isotope (Δ
                    <sub>47</sub>
                    ) in Modern Terrestrial Carbonates From the Southeastern Tibetan Plateau: Implications for Paleoelevation Reconstruction}},
  journal = {Journal of Geophysical Research: Earth Surface},
  year    = {2025},
  volume  = {130},
  number  = {12},
